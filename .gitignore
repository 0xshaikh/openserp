# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
man/

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Local data — rank history DB is user-local state, never committed
.openserp/
*.db
*.sqlite
*.sqlite3

# Rank history written by tests or local runs
rank.db

# Competitor profile reports generated by `openserp compete`
competitor-*.md

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Captured CLI transcripts used only to render screenshots
*.txt.log
captures/

# Secrets — never commit
.env
.env.*
*.pem
*.key
*credentials*
